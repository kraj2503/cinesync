{
  "manifest_version": 3,
  "name": "CineSync — Watch Party",
  "version": "1.0.0",
  "description": "Watch movies in sync with friends on Disney+, Hotstar, Netflix, and more.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.hotstar.com/*",
    "*://*.disneyplus.com/*",
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.youtube.com/*",
    "*://*.hulu.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hotstar.com/*",
        "*://*.disneyplus.com/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "*://*.hulu.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
